pcall(function()
    local SoundService = game:GetService("SoundService")
    for _, old in ipairs(SoundService:GetChildren()) do
        if old:IsA("Sound") and old.Name == "NIGHTDLC_AnimeStartup" then
            old:Destroy()
        end
    end
    local startupSound = Instance.new("Sound")
    startupSound.Name = "NIGHTDLC_AnimeStartup"
    startupSound.SoundId = "rbxassetid://78798011197804"
    startupSound.Volume = 0.65
    startupSound.PlaybackSpeed = 1
    startupSound.Parent = SoundService
    SoundService:PlayLocalSound(startupSound)
    task.delay(12, function()
        if startupSound and startupSound.Parent then
            startupSound:Destroy()
        end
    end)
end)

